<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>スカルプ・ハーブゴマージュ | THE HERBS プロフェッショナル</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Noto+Sans+JP:wght@300;400;500&family=Noto+Serif+JP:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --cream:      #f5f0e8;
    --warm-white: #faf8f4;
    --deep-green: #1a2e1a;
    --forest:     #2d4a2d;
    --sage:       #6b8f5e;
    --sage-light: #9ab88a;
    --moss:       #b8c9a8;
    --gold:       #c9a96e;
    --gold-light: #e8d5a8;
    --charcoal:   #2a2a2a;
    --warm-gray:  #7a7060;
    --border:     rgba(107,143,94,0.25);
    --content-max:  1400px;
    --section-px:   clamp(1.2rem, 3vw, 2.5rem);
    --section-py:   clamp(3.5rem, 7vw, 8rem);
  }
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--warm-white);
    color: var(--charcoal);
    font-family: 'Noto Sans JP', serif;
    font-weight: 400;
    overflow-x: hidden;
  }
  .inner {
    max-width: var(--content-max);
    margin-inline: auto;
    width: 100%;
    padding-inline: var(--section-px);
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: rgba(26,46,26,0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(107,143,94,0.15);
    transition: transform 0.4s ease;
  }
  .nav-inner {
    max-width: var(--content-max);
    margin-inline: auto;
    width: 100%;
    padding: 1.2rem var(--section-px);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav-brand {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    letter-spacing: 0.28em;
    color: var(--cream);
    text-decoration: none;
  }
  .nav-links { display: flex; gap: 2.2rem; list-style: none; }
  .nav-links a {
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    color: rgba(245,240,232,0.6);
    text-decoration: none;
    transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--sage-light); }

  /* ── HERO ── */
  .hero {
    position: relative;
    min-height: 100vh;
    background: #2c3d28;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 6rem;
    padding-bottom: 3rem;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://herbspro2020.bcart.jp/uploads/main_image/freepage/man_gommage.JPG');
    background-size: cover;
    background-position: center 30%;
    opacity: 0.52;
    z-index: 0;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 72% 50%, rgba(107,143,94,0.10) 0%, transparent 65%),
      radial-gradient(ellipse at 18% 85%, rgba(201,169,110,0.12) 0%, transparent 50%);
    z-index: 0;
  }
  .hero-inner {
    max-width: var(--content-max);
    margin-inline: auto;
    width: 100%;
    padding-inline: var(--section-px);
    position: relative;
    z-index: 1;
  }
  .hero-tag {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: var(--gold-light);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
    opacity: 0;
    animation: fadeUp 0.9s 0.3s forwards;
  }
  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: clamp(5rem, 7.5vw, 9rem);
    color: var(--cream);
    line-height: 1.05;
    letter-spacing: -0.03em;
    opacity: 0;
    animation: fadeUp 0.9s 0.5s forwards;
  }
  .hero-title em { font-style: italic; color: var(--sage-light); }
  .hero-subtitle {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(1.6rem, 2.8vw, 3.2rem);
    color: rgba(245,240,232,0.65);
    margin-top: 1.2rem;
    letter-spacing: 0.12em;
    font-weight: 400;
    opacity: 0;
    animation: fadeUp 0.9s 0.7s forwards;
  }
  .hero-divider {
    width: 80px; height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
    margin: 2.2rem 0;
    opacity: 0;
    animation: fadeUp 0.9s 0.9s forwards;
  }
  .hero-lead {
    max-width: 550px;
    font-size: clamp(1.0rem, 1.6vw, 1.3rem);
    color: rgba(245,240,232,0.6);
    line-height: 1.8;
    letter-spacing: 0.05em;
    opacity: 0;
    animation: fadeUp 0.9s 1.1s forwards;
  }
  .hero-summer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(201,169,110,0.15);
    border: 1px solid rgba(201,169,110,0.45);
    color: var(--gold-light);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    padding: 0.45rem 1.1rem;
    margin-bottom: 1.4rem;
    opacity: 0;
    animation: fadeUp 0.9s 0.1s forwards;
  }
  .hero-summer-badge span { font-size: 0.75rem; opacity: 0.7; }
  .hero-metrics {
    display: flex;
    gap: 2.5rem;
    margin-top: 2.8rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(107,143,94,0.2);
    opacity: 0;
    animation: fadeUp 0.9s 1.4s forwards;
    flex-wrap: wrap;
  }
  .hero-metric-item { display: flex; flex-direction: column; gap: 0.3rem; }
  .hero-metric-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 300;
    color: var(--gold-light);
    line-height: 1;
  }
  .hero-metric-label {
    font-size: 0.78rem;
    color: rgba(245,240,232,0.5);
    letter-spacing: 0.12em;
  }
  .hero-metric-divider {
    width: 1px;
    background: rgba(107,143,94,0.25);
    align-self: stretch;
  }
  .hero-cta-group {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-top: 2.8rem;
    opacity: 0;
    animation: fadeUp 0.9s 1.3s forwards;
  }
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 2.6rem;
    background: var(--gold);
    color: var(--deep-green);
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
  }
  .hero-btn-primary:hover { background: var(--gold-light); transform: translateY(-2px); }
  .hero-btn-outline-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.1rem 2.4rem;
    background: transparent;
    color: var(--cream);
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    border: 1px solid rgba(245,240,232,0.35);
    cursor: pointer;
    transition: border-color 0.3s, color 0.3s, background 0.3s;
  }
  .hero-btn-outline-hero:hover {
    border-color: var(--sage-light);
    color: var(--sage-light);
  }

  /* ── URGENCY BANNER ── */
  .urgency-banner {
    background: linear-gradient(135deg, var(--forest), var(--deep-green));
    border-top: 1px solid rgba(201,169,110,0.3);
    border-bottom: 1px solid rgba(201,169,110,0.3);
    padding: 1rem var(--section-px);
    text-align: center;
  }
  .urgency-banner p {
    font-size: 0.85rem;
    color: var(--gold-light);
    letter-spacing: 0.12em;
  }
  .urgency-banner strong { color: #fff; }

  /* ── SECTIONS ── */
  section { padding: var(--section-py) 0; }
  .section-label {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 0.85rem;
    letter-spacing: 0.38em;
    text-transform: uppercase;
    color: var(--sage);
    margin-bottom: 0.75rem;
  }
  .section-title {
    font-family: 'Noto Serif JP', serif;
    font-weight: 300;
    font-size: clamp(2rem, 2.6vw, 2.8rem);
    line-height: 1.3;
    color: var(--deep-green);
  }
  .section-title em { font-style: italic; color: var(--sage); }

  /* ── CONCEPT ── */
  .concept { background: var(--cream); }
  .concept-grid {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--section-px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: center;
  }
  .concept-text p {
    margin-top: 1.8rem;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 2;
    color: var(--warm-gray);
    letter-spacing: 0.04em;
  }
  .concept-card {
    background: var(--deep-green);
    padding: clamp(2rem, 3.5vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }
  .concept-card::before {
    content: '';
    position: absolute;
    top: -30%; right: -20%;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(107,143,94,0.22), transparent);
  }
  .concept-card-label {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 0.85rem;
    letter-spacing: 0.32em;
    color: var(--gold-light);
    margin-bottom: 1.4rem;
  }
  .concept-card-title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(1.6rem, 2.5vw, 2.4rem);
    font-weight: 300;
    line-height: 1.4;
    color: var(--cream);
    margin-bottom: 1.8rem;
  }
  .concept-card-title em { font-style: italic; color: var(--sage-light); }
  .concept-card-body {
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    line-height: 2;
    color: rgba(245,240,232,0.65);
  }

  /* ── SUMMER PROBLEM ── */
  .summer-problem {
    background: var(--warm-white);
    border-top: 1px solid var(--border);
  }
  .summer-problem-inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--section-px);
  }
  .summer-problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .problem-card {
    background: var(--cream);
    padding: 2rem;
    border-left: 3px solid var(--sage);
  }
  .problem-card-icon {
    width: 48px; height: 48px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(107,143,94,0.12);
    border-radius: 50%;
  }
  .problem-card h3 {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--deep-green);
    margin-bottom: 0.8rem;
    line-height: 1.5;
  }
  .problem-card p { font-size: 0.88rem; color: var(--warm-gray); line-height: 1.9; }
  .problem-arrow {
    text-align: center;
    padding: 2.5rem 0 1rem;
    font-family: 'Noto Serif JP', serif;
    font-size: 1.1rem;
    color: var(--sage);
    letter-spacing: 0.1em;
  }
  .problem-solution {
    background: var(--deep-green);
    padding: 2.5rem;
    text-align: center;
  }
  .problem-solution p {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    color: var(--cream);
    line-height: 1.8;
    letter-spacing: 0.06em;
  }
  .problem-solution em { color: var(--gold-light); font-style: normal; }

  /* ── HERBS ── */
  .herbs { background: var(--warm-white); }
  .herbs-header {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--section-px);
    margin-bottom: 4rem;
  }
  .herbs-grid {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--section-px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .herb-card {
    background: var(--cream);
    position: relative;
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    display: flex;
    flex-direction: column;
  }
  .herb-card-img {
    width: 75%; height: 220px;
    object-fit: cover;
    display: block;
    margin: auto;
    padding-top: 1.5rem;
    transition: transform 0.5s ease;
  }
  .herb-card:hover .herb-card-img { transform: scale(1.04); }
  .herb-card-body {
    padding: clamp(1.6rem, 2vw, 2.4rem);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .herb-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 22px 60px rgba(26,46,26,0.12);
    z-index: 2;
  }
  .herb-num {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 0.85rem;
    letter-spacing: 0.32em;
    color: var(--gold);
    margin-bottom: 0.4rem;
  }
  .herb-name-jp {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 400;
    color: var(--deep-green);
    margin-bottom: 0.2rem;
  }
  .herb-name-en {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--sage);
    letter-spacing: 0.1em;
    margin-bottom: 1.2rem;
  }
  .herb-divider { width: 40px; height: 1px; background: var(--moss); margin-bottom: 1.2rem; }
  .herb-effects { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.2rem; }
  .herb-tag {
    font-size: 0.78rem;
    padding: 0.32rem 0.75rem;
    background: rgba(107,143,94,0.11);
    color: var(--forest);
    border: 1px solid var(--border);
    border-radius: 20px;
    letter-spacing: 0.04em;
  }
  .herb-detail {
    font-size: clamp(0.88rem, 1.05vw, 1rem);
    line-height: 2;
    color: var(--warm-gray);
    border-top: 1px solid var(--border);
    padding-top: 1.2rem;
  }
  .herb-data {
    margin-top: 1.2rem;
    padding: 1rem 1.2rem;
    background: rgba(26,46,26,0.05);
    border-left: 2px solid var(--sage);
  }
  .herb-data-title {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--sage);
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .herb-data p { font-size: 0.85rem; color: var(--warm-gray); line-height: 1.85; }

  /* ── BENEFITS ── */
  .benefits { background: var(--deep-green); color: var(--cream); }
  .benefits-header {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--section-px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 5rem);
    align-items: end;
    margin-bottom: 4rem;
  }
  .benefits-header .section-title { color: var(--cream); }
  .benefits-header .section-title em { color: var(--sage-light); }
  .benefits-intro {
    font-size: clamp(0.9rem, 1.3vw, 1.1rem);
    line-height: 2;
    color: rgba(245,240,232,0.6);
    align-self: end;
  }
  .benefits-list {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--section-px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: rgba(107,143,94,0.15);
  }
  .benefit-item {
    background: var(--deep-green);
    padding: clamp(2rem, 2.5vw, 3rem) clamp(1.8rem, 3vw, 3.5rem);
    border-top: 1px solid rgba(107,143,94,0.18);
    transition: background 0.3s ease;
    display: flex;
    gap: 1.6rem;
    align-items: flex-start;
  }
  .benefit-item:hover { background: rgba(107,143,94,0.07); }
  .benefit-icon-wrap {
    width: 48px; height: 48px;
    border: 1px solid rgba(107,143,94,0.35);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .benefit-num {
    font-family: 'Noto Serif JP', serif;
    font-style: italic;
    font-size: 2.2rem;
    color: rgba(107,143,94,0.28);
    line-height: 1;
    margin-bottom: 0.8rem;
  }
  .benefit-title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 0.8rem;
    letter-spacing: 0.04em;
  }
  .benefit-body {
    font-size: clamp(0.88rem, 1.1vw, 1rem);
    line-height: 2;
    color: rgba(245,240,232,0.58);
  }

  /* ── RESULT ── */
  .result { background: var(--cream); }
  .result-grid {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--section-px);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(3rem, 6vw, 8rem);
    align-items: center;
  }
  .result-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .result-photo {
    aspect-ratio: 3/4;
    background: var(--forest);
    position: relative;
    overflow: hidden;
  }
  .result-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .result-photo.before { margin-top: 2rem; }
  .result-photo-label {
    position: absolute;
    bottom: 1rem; left: 50%; transform: translateX(-50%);
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    color: rgba(245,240,232,0.55);
    white-space: nowrap;
    background: rgba(26,46,26,0.5);
    padding: 0.2rem 0.6rem;
  }
  .result-text p {
    margin-top: 1.8rem;
    font-size: clamp(0.9rem, 1.3vw, 1.1rem);
    line-height: 2;
    color: var(--warm-gray);
  }
  .result-stat {
    margin-top: 2.5rem;
    padding: 2rem;
    background: var(--deep-green);
    color: var(--cream);
  }
  .result-stat-num {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(2.2rem, 3vw, 3.5rem);
    font-weight: 300;
    color: var(--gold-light);
    line-height: 1;
  }
  .result-stat-label {
    font-size: 0.85rem;
    color: rgba(245,240,232,0.6);
    margin-top: 0.5rem;
    letter-spacing: 0.06em;
  }
  .result-note {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: rgba(122,112,96,0.7);
    letter-spacing: 0.04em;
  }

  /* ── VOICE ── */
  .voice { background: var(--warm-white); }
  .voice-inner {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--section-px);
  }
  .voice-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .voice-card {
    background: var(--cream);
    padding: 2rem;
    position: relative;
    border-top: 3px solid var(--sage);
  }
  .voice-card::before {
    content: '"';
    position: absolute;
    top: 1.2rem; right: 1.5rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 4rem;
    color: rgba(107,143,94,0.15);
    line-height: 1;
  }
  .voice-text { font-size: 0.92rem; line-height: 2; color: var(--warm-gray); margin-bottom: 1.5rem; }
  .voice-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .voice-avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--forest);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .voice-name { font-family: 'Noto Serif JP', serif; font-size: 0.88rem; color: var(--deep-green); font-weight: 400; }
  .voice-salon { font-size: 0.78rem; color: var(--warm-gray); margin-top: 0.15rem; }
  .voice-stars { margin-left: auto; color: var(--gold); font-size: 0.85rem; letter-spacing: 0.1em; }

  /* ── HOW TO USE ── */
  .howto { background: var(--warm-white); }
  .howto-inner {
    max-width: var(--content-max);
