<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>THE HERBS — Botanical Professional Care</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Noto+Serif+JP:wght@200;300;400;500&family=Noto+Sans+JP:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #F6FAF5;
    --sage: #ABBAA9;
    --sage-light: #c8d4c6;
    --sage-dark: #5a7257;
    --earth: #8c7355;
    --earth-light: #c4a882;
    --charcoal: #2C2319;
    --stone: #5a5246;
    --mist: #e2eae1;
    --white: #fdfcfa;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--cream);
    color: var(--charcoal);
    font-family: 'Noto Serif JP', serif;
    font-weight: 400;
    font-size: 16px;
    overflow-x: hidden;
    line-height: 1.9;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, rgba(171,186,169,0.18) 0%, transparent 70%),
      radial-gradient(ellipse 40% 60% at 20% 70%, rgba(196,168,130,0.10) 0%, transparent 60%);
  }

  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Ccircle cx='40' cy='40' r='1' fill='%23ABBAA9' fill-opacity='0.10'/%3E%3C/g%3E%3C/svg%3E");
  }

  .hero-image-overlay {
    position: absolute;
    right: 0;
    top: 0;
    width: 48%;
    height: 100%;
    background: url('https://static.wixstatic.com/media/a3e22d_b998cf0d14ce493a9c375a055702e0e4~mv2.jpg') center/cover no-repeat;
    opacity: 0.72;
    mask-image: linear-gradient(to left, rgba(0,0,0,0.95) 30%, rgba(0,0,0,0.3) 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,0.95) 30%, rgba(0,0,0,0.3) 80%, transparent 100%);
    pointer-events: none;
  }

  nav {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 4rem;
    border-bottom: 1px solid rgba(171,186,169,0.3);
  }

  .logo img { height: 22px; width: auto; }

  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }

  .nav-links a {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--stone);
    text-decoration: none;
    transition: color 0.3s;
  }

  .nav-links a:hover { color: var(--sage-dark); }

  .hero-content {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 2rem;
    gap: 1.5rem;
  }

  .hero-eyebrow {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    color: var(--sage-dark);
    opacity: 0;
    animation: fadeUp 0.8s ease 0.2s forwards;
  }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3rem, 7.8vw, 5rem);
    font-weight: 400;
    line-height: 1.0;
    letter-spacing: 0.06em;
    color: var(--charcoal);
    opacity: 0;
    animation: fadeUp 0.8s ease 0.4s forwards;
  }

  .hero-title em { font-style: italic; color: var(--sage-dark); }

  .hero-subtitle {
    font-size: 1rem;
    line-height: 2.0;
    color: var(--stone);
    max-width: 520px;
    font-weight: 400;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.6s forwards;
  }

  .hero-divider {
    width: 60px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--sage), transparent);
    opacity: 0;
    animation: fadeUp 0.8s ease 0.7s forwards;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.8s forwards;
  }

  .btn {
    padding: 0.85rem 2rem;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: all 0.35s;
    cursor: pointer;
    border: none;
    display: inline-block;
  }

  .btn-primary { background: var(--sage-dark); color: var(--white); }
  .btn-primary:hover { background: var(--charcoal); transform: translateY(-2px); }
  .btn-outline { background: transparent; color: var(--sage-dark); border: 1px solid var(--sage); }
  .btn-outline:hover { background: var(--sage-dark); color: var(--white); transform: translateY(-2px); }

  .hero-footer {
    position: relative;
    z-index: 5;
    padding: 1.5rem 4rem;
    display: flex;
    justify-content: center;
    gap: 3rem;
    border-top: 1px solid rgba(171,186,169,0.2);
  }

  .hero-stat { text-align: center; }

  .hero-stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.4rem;
    font-weight: 300;
    color: var(--sage-dark);
  }

  .hero-stat-label {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--stone);
    margin-top: 0.2rem;
  }

  /* ── SECTION COMMONS ── */
  section { position: relative; }

  .section-header {
    text-align: center;
    padding: 5rem 2rem 2.5rem;
  }

  .section-tag {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--sage-dark);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.8rem;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--charcoal);
    line-height: 1.25;
  }

  .section-title em { font-style: italic; color: var(--sage-dark); }

  .section-desc {
    margin-top: 1.2rem;
    font-size: 0.95rem;
    line-height: 2.0;
    color: var(--stone);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
    font-weight: 400;
  }

  .section-line {
    width: 40px;
    height: 1px;
    background: var(--sage);
    margin: 1.4rem auto 0;
  }

  /* ── WHAT IS HERB CARE ── */
  .what-section {
    background: var(--white);
    padding: 5rem 4vw 5.5rem;
    border-top: 1px solid var(--mist);
  }

  .what-inner { max-width: 960px; margin: 0 auto; }

  .what-lead-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    margin-bottom: 4rem;
  }

  .what-lead-text .section-tag { text-align: left; }

  .what-headline {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    color: var(--charcoal);
    line-height: 1.25;
    margin-bottom: 1.4rem;
  }

  .what-headline em { font-style: italic; color: var(--sage-dark); }

  .what-body {
    font-size: 1rem;
    line-height: 2.1;
    color: var(--stone);
    font-weight: 400;
  }

  .what-body strong { color: var(--charcoal); font-weight: 500; }

  .what-visual {
    background: var(--cream);
    border: 1px solid var(--mist);
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .what-visual img { width: 100%; height: 100%; object-fit: cover; }

  .what-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-bottom: 3.5rem;
    background: var(--mist);
    border: 1px solid var(--mist);
  }

  .what-point { background: var(--white); padding: 2rem 1.8rem; }

  .what-point-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.8rem;
    font-weight: 300;
    color: var(--sage);
    line-height: 1;
    margin-bottom: 0.8rem;
  }

  .what-point-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 1rem;
    font-weight: 500;
    color: var(--charcoal);
    margin-bottom: 0.7rem;
    line-height: 1.6;
  }

  .what-point-body {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9rem;
    line-height: 2.0;
    color: var(--stone);
    font-weight: 400;
  }

  .what-diff {
    background: var(--cream);
    border: 1px solid var(--mist);
    padding: 2rem 2.4rem;
    margin-bottom: 3rem;
  }

  .what-diff-label {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--sage-dark);
    text-transform: uppercase;
    margin-bottom: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--mist);
  }

  .diff-table { width: 100%; border-collapse: collapse; }

  .diff-table th {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--sage-dark);
    padding: 0.6rem 1rem 0.6rem 0;
    text-align: left;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--mist);
    width: 28%;
  }

  .diff-table th:last-child { color: var(--charcoal); }

  .diff-table td {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9rem;
    color: var(--stone);
    padding: 0.9rem 1rem 0.9rem 0;
    border-bottom: 1px solid rgba(226,234,225,0.6);
    vertical-align: top;
    line-height: 1.8;
    font-weight: 400;
  }

  .diff-table td:first-child { color: var(--charcoal); font-weight: 500; white-space: nowrap; }
  .diff-table td.good { color: var(--sage-dark); font-weight: 500; }

  .what-cycle {
    background: var(--sage-dark);
    color: var(--white);
    padding: 2rem 2.4rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .what-cycle-icon {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5rem;
    font-weight: 300;
    color: var(--sage-light);
    line-height: 1;
    flex-shrink: 0;
  }

  .what-cycle-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.05rem;
    font-weight: 500;
    color: #fff;
    margin-bottom: 0.4rem;
  }

  .what-cycle-desc {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9rem;
    line-height: 1.9;
    color: rgba(246,250,245,0.75);
    font-weight: 400;
  }

  /* ── TAB NAVIGATION ── */
  .tab-section { background: var(--white); }

  .tab-nav {
    display: flex;
    justify-content: center;
    border-bottom: 1px solid var(--mist);
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--white);
    flex-wrap: wrap;
  }

  .tab-btn {
    padding: 1.1rem 2rem;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--stone);
    border: none;
    background: none;
    cursor: pointer;
    position: relative;
    transition: color 0.3s;
    white-space: nowrap;
  }

  .tab-btn::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0; right: 0;
    height: 2px;
    background: var(--sage-dark);
    transform: scaleX(0);
    transition: transform 0.35s;
  }

  .tab-btn.active { color: var(--sage-dark); }
  .tab-btn.active::after { transform: scaleX(1); }

  .tab-content {
    display: none;
    padding: 3rem 4vw 5rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .tab-content.active { display: block; }

  /* ── PRODUCT GRID ── */
  .product-intro {
    background: var(--cream);
    border-left: 4px solid var(--sage);
    padding: 1.6rem 1.8rem;
    margin-bottom: 2.5rem;
    font-size: 0.95rem;
    line-height: 2.0;
    color: var(--stone);
    max-width: 740px;
    font-weight: 400;
  }

  .product-intro strong { color: var(--sage-dark); font-weight: 500; }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2px;
  }

  .product-card {
    background: var(--white);
    position: relative;
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    cursor: default;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(44,35,25,0.10);
    z-index: 2;
  }

  .product-card-image {
    width: 100%;
    aspect-ratio: 4/3;
    background: var(--mist);
    overflow: hidden;
  }

  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .product-card:hover .product-card-image img { transform: scale(1.04); }

  .product-card-body {
    padding: 1.6rem 1.8rem;
    border-top: 1px solid var(--mist);
  }

  .product-name-fr {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--charcoal);
  }

  .product-name-jp {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--sage-dark);
    margin-top: 0.2rem;
    display: block;
  }

  .product-tagline {
    margin-top: 0.8rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--earth);
    letter-spacing: 0.03em;
  }

  .product-concerns {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .concern-tag {
    padding: 0.3rem 0.7rem;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--stone);
    background: var(--cream);
    border: 1px solid var(--mist);
  }

  .product-herbs {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--mist);
  }

  .herbs-label {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--sage-dark);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .herb-list { display: flex; flex-wrap: wrap; gap: 0.3rem; }

  .herb-item {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--stone);
  }

  .herb-item::after { content: '·'; margin-left: 0.4rem; color: var(--sage); }
  .herb-item:last-child::after { content: ''; }

  /* ── HOW TO USE ── */
  .howto-section {
    background: var(--charcoal);
    color: var(--cream);
    padding: 5rem 4vw;
  }

  .howto-grid {
    max-width: 900px;
    margin: 2.5rem auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
  }

  .howto-card {
    background: rgba(246,250,245,0.05);
    padding: 2rem;
    border: 1px solid rgba(171,186,169,0.2);
    transition: background 0.3s;
  }

  .howto-card:hover { background: rgba(246,250,245,0.09); }

  .howto-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3rem;
    font-weight: 300;
    color: rgba(171,186,169,0.3);
    line-height: 1;
    margin-bottom: 0.8rem;
  }

  .howto-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--cream);
    margin-bottom: 0.8rem;
  }

  .howto-desc {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.9rem;
    line-height: 2.0;
    color: rgba(246,250,245,0.65);
    font-weight: 400;
  }

  .howto-note {
    margin: 2rem auto 0;
    max-width: 900px;
    background: rgba(171,186,169,0.1);
    border-left: 2px solid var(--sage);
    padding: 1rem 1.4rem;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.85rem;
    font-weight: 400;
    line-height: 1.9;
    color: rgba(246,250,245,0.6);
  }

  /* ── CONCEPT ── */
  .concept-section { padding: 6rem 4vw; background: var(--white); }

  .concept-inner { max-width: 800px; margin: 0 auto; text-align: center; }

  .concept-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.8;
    color: var(--charcoal);
    margin-bottom: 2rem;
  }

  .concept-body {
    font-size: 0.95rem;
    line-height: 2.1;
    color: var(--stone);
    max-width: 580px;
    margin: 0 auto;
    font-weight: 400;
  }

  /* ── FOOTER ── */
  footer {
    background: var(--charcoal);
    color: rgba(246,250,245,0.5);
    padding: 2.5rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .footer-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 300;
    letter-spacing: 0.2em;
    color: var(--cream);
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .reveal.visible { opacity: 1; transform: translateY(0); }

  .stagger .reveal:nth-child(1) { transition-delay: 0.05s; }
  .stagger .reveal:nth-child(2) { transition-delay: 0.12s; }
  .stagger .reveal:nth-child(3) { transition-delay: 0.19s; }
  .stagger .reveal:nth-child(4) { transition-delay: 0.26s; }
  .stagger .reveal:nth-child(5) { transition-delay: 0.33s; }
  .stagger .reveal:nth-child(6) { transition-delay: 0.40s; }
  .stagger .reveal:nth-child(7) { transition-delay: 0.47s; }

  /* ── CORAIL FEATURED ── */
  .corail-featured { margin-bottom: 3.5rem; }

  .category-label {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.5rem;
  }

  .category-label-text {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--sage-dark);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .category-label-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--sage), transparent);
  }

  .corail-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--charcoal);
    position: relative;
    overflow: hidden;
    min-height: 320px;
  }

  .corail-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 90% 50%, rgba(176,90,74,0.15) 0%, transparent 65%),
      radial-gradient(ellipse 40% 60% at 10% 80%, rgba(171,186,169,0.08) 0%, transparent 55%);
    pointer-events: none;
  }

  .corail-image { position: relative; overflow: hidden; }
  .corail-image img { width: 100%; height: 100%; object-fit: cover; }

  .corail-body {
    padding: 2.5rem 2.5rem 2.5rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .corail-badge {
    display: inline-block;
    padding: 0.28rem 0.8rem;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: #b05a4a;
    border: 1px solid rgba(176,90,74,0.5);
    margin-bottom: 1.2rem;
    width: fit-content;
  }

  .corail-name-fr {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--cream);
