<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>エステの基礎を学ぶ、フェイスケア講習会 | 1年間プログラム</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;600&family=Zen+Old+Mincho:wght@400;700&family=Noto+Sans+JP:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --ivory: #FAF6F0;
    --cream: #F2EAE0;
    --warm-brown: #8C6D5A;
    --dark-brown: #3D2B1F;
    --gold: #C4A265;
    --light-gold: #E8D5B0;
    --sage: #7A8C72;
    --blush: #D4A49A;
    --text: #2C1F17;
    --text-light: #6B5248;

    /* スケール基準：PC 16px / スマホ 14px */
    --base: clamp(15px, 1.2vw, 20px);
    --section-pad: 96px;
    --container-max: 1200px;
    --container-px: 80px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { font-size: var(--base); }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Noto Sans JP', sans-serif;
    background: var(--ivory);
    color: var(--text);
    overflow-x: hidden;
    line-height: 1.7;
  }

  /* CMS breakout */
  #lp-wrapper {
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 55% 45%;
    position: relative;
    overflow: hidden;
  }

  .hero-left {
    background: var(--dark-brown);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 72px 80px 80px;
    position: relative;
    z-index: 1;
  }

  .hero-left::after {
    content: '';
    position: absolute;
    right: -60px;
    top: 0;
    bottom: 0;
    width: 120px;
    background: var(--dark-brown);
    clip-path: polygon(0 0, 0 100%, 100% 100%);
    z-index: 2;
  }

  .hero-right {
    background: var(--cream);
    position: relative;
    overflow: hidden;
  }

  .hero-right-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 70% 30%, rgba(196,162,101,0.2) 0%, transparent 60%),
      radial-gradient(ellipse at 20% 80%, rgba(212,164,154,0.2) 0%, transparent 50%);
  }

  .hero-right-content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 60px 60px;
  }

  .hero-eyebrow {
    font-size: clamp(11px, 0.85vw, 14px);
    font-weight: 500;
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease forwards 0.3s;
  }

  .hero-title {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(30px, 3.6vw, 58px);
    font-weight: 400;
    color: var(--ivory);
    line-height: 1.6;
    margin-bottom: 10px;
    opacity: 0;
    animation: fadeUp 0.8s ease forwards 0.5s;
  }

  .hero-title span { color: var(--gold); }

  .hero-subtitle {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(14px, 1.1vw, 18px);
    color: rgba(250,246,240,0.6);
    line-height: 2.1;
    margin-top: 20px;
    margin-bottom: 36px;
    opacity: 0;
    animation: fadeUp 0.8s ease forwards 0.7s;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    opacity: 0;
    animation: fadeUp 0.8s ease forwards 0.9s;
  }

  .badge {
    background: rgba(196,162,101,0.12);
    border: 1px solid rgba(196,162,101,0.4);
    color: var(--light-gold);
    font-size: clamp(11px, 0.85vw, 14px);
    letter-spacing: 1px;
    padding: clamp(5px,0.4vw,8px) clamp(14px,1.1vw,20px);
    border-radius: 2px;
  }

  .hero-visual {
    opacity: 0;
    animation: fadeIn 1.2s ease forwards 0.4s;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-circle {
    width: clamp(240px, 22vw, 360px);
    height: clamp(240px, 22vw, 360px);
    border-radius: 50%;
    border: 1px solid rgba(196,162,101,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .hero-circle::before {
    content: '';
    position: absolute;
    inset: 20px;
    border-radius: 50%;
    border: 1px solid rgba(196,162,101,0.2);
  }

  .hero-circle-inner { text-align: center; }

  .hero-circle-num {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(56px, 5.5vw, 90px);
    color: var(--gold);
    line-height: 1;
    display: block;
  }

  .hero-circle-label {
    font-size: clamp(11px, 0.85vw, 14px);
    color: var(--text-light);
    letter-spacing: 2px;
    margin-top: 8px;
    display: block;
  }

  .hero-price-info {
    margin-top: 32px;
    text-align: center;
  }

  .hero-price-label {
    font-size: clamp(11px, 0.85vw, 14px);
    letter-spacing: 2px;
    color: var(--text-light);
    margin-bottom: 6px;
  }

  .hero-price {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(28px, 2.6vw, 44px);
    color: var(--dark-brown);
  }

  .hero-price sub {
    font-size: clamp(13px, 1vw, 16px);
    font-family: 'Noto Sans JP', sans-serif;
  }

  /* ── CONCEPT ── */
  .concept {
    padding: var(--section-pad) 0;
    background: var(--ivory);
    position: relative;
  }

  .concept::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-px);
  }

  .section-label {
    font-size: clamp(10px, 0.75vw, 13px);
    letter-spacing: 5px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .section-title {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(26px, 3.0vw, 48px);
    font-weight: 400;
    line-height: 1.7;
    color: var(--dark-brown);
    margin-bottom: 0;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: start;
    margin-top: 56px;
  }

  .concept-text {
    font-size: clamp(14px, 1.1vw, 17px);
    line-height: 2.2;
    color: var(--text-light);
  }

  .concept-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .concept-card {
    background: var(--cream);
    padding: 24px 28px;
    border-left: 3px solid var(--gold);
  }

  .concept-card-title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(14px, 1.1vw, 17px);
    font-weight: 600;
    color: var(--dark-brown);
    margin-bottom: 7px;
  }

  .concept-card-text {
    font-size: clamp(13px, 1vw, 16px);
    line-height: 1.9;
    color: var(--text-light);
  }

  /* ── FOR WHO ── */
  .for-who {
    background: var(--dark-brown);
    padding: var(--section-pad) 0;
    position: relative;
    overflow: hidden;
  }

  .for-who::before {
    content: 'FOR';
    position: absolute;
    right: -20px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    font-family: 'Zen Old Mincho', serif;
    font-size: 160px;
    color: rgba(255,255,255,0.03);
    letter-spacing: 20px;
    white-space: nowrap;
  }

  .for-who .section-title { color: var(--ivory); }
  .for-who .section-label { color: var(--gold); }

  .for-who-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 48px;
  }

  .for-who-item {
    background: rgba(255,255,255,0.04);
    padding: 36px 28px;
    border-top: 1px solid rgba(196,162,101,0.2);
    transition: background 0.3s;
  }

  .for-who-item:hover { background: rgba(196,162,101,0.08); }

  .for-who-num {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(28px, 2.8vw, 48px);
    color: var(--gold);
    opacity: 0.5;
    display: block;
    margin-bottom: 14px;
  }

  .for-who-title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(15px, 1.15vw, 19px);
    color: var(--ivory);
    margin-bottom: 10px;
    line-height: 1.6;
  }

  .for-who-desc {
    font-size: clamp(13px, 1vw, 16px);
    color: rgba(250,246,240,0.5);
    line-height: 2;
  }

  /* ── CURRICULUM ── */
  .curriculum {
    padding: var(--section-pad) 0;
    background: var(--ivory);
  }

  .curriculum-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    margin-bottom: 64px;
    align-items: end;
  }

  .curriculum-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: var(--cream);
  }

  .meta-icon {
    width: 36px;
    height: 36px;
    background: var(--gold);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .meta-label {
    font-size: clamp(10px, 0.75vw, 13px);
    letter-spacing: 2px;
    color: var(--text-light);
    margin-bottom: 3px;
  }

  .meta-value {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(14px, 1.1vw, 17px);
    color: var(--dark-brown);
  }

  /* Sessions */
  .sessions { display: grid; gap: 0; }

  .session {
    display: grid;
    grid-template-columns: clamp(80px, 7vw, 120px) 1fr;
    border-top: 1px solid rgba(139,109,90,0.15);
    overflow: hidden;
    transition: background 0.25s ease;
  }

  .session:last-child { border-bottom: 1px solid rgba(139,109,90,0.15); }
  .session:hover { background: var(--cream); }

  .session-num {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px 16px;
    background: var(--cream);
    border-right: 1px solid rgba(139,109,90,0.15);
    flex-direction: column;
    gap: 4px;
    transition: background 0.25s;
  }

  .session:hover .session-num { background: var(--gold); }

  .session-num-text {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(18px, 1.6vw, 28px);
    color: var(--dark-brown);
    transition: color 0.25s;
  }

  .session:hover .session-num-text { color: var(--ivory); }

  .session-num-label {
    font-size: clamp(9px, 0.65vw, 12px);
    letter-spacing: 2px;
    color: var(--text-light);
    transition: color 0.25s;
  }

  .session:hover .session-num-label { color: rgba(250,246,240,0.7); }

  .session-body { padding: 24px 36px; }

  .session-date {
    font-size: clamp(11px, 0.85vw, 14px);
    letter-spacing: 2px;
    color: var(--gold);
    margin-bottom: 7px;
  }

  .session-title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(15px, 1.3vw, 20px);
    color: var(--dark-brown);
    font-weight: 600;
    margin-bottom: 5px;
    line-height: 1.6;
  }

  .session-subtitle {
    font-size: clamp(12px, 0.9vw, 15px);
    color: var(--warm-brown);
    margin-bottom: 10px;
  }

  .session-desc {
    font-size: clamp(13px, 1vw, 16px);
    line-height: 2;
    color: var(--text-light);
  }

  .session-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .tag {
    background: rgba(122,140,114,0.12);
    color: var(--sage);
    font-size: clamp(10px, 0.75vw, 13px);
    padding: clamp(3px,0.3vw,5px) clamp(10px,0.85vw,14px);
    letter-spacing: 1px;
  }

  .tag.brown {
    background: rgba(139,109,90,0.12);
    color: var(--warm-brown);
  }

  .session-note {
    font-size: clamp(11px, 0.85vw, 14px);
    color: var(--blush);
    margin-top: 8px;
    padding-left: 12px;
    border-left: 2px solid var(--blush);
  }

  .session-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    flex-wrap: wrap;
  }

  /* 共通 */
  .session-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: clamp(11px, 0.85vw, 13px);
    letter-spacing: 1.5px;
    padding: clamp(8px,0.65vw,11px) clamp(14px,1.2vw,20px);
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  /* 本講座ボタン：ダークブラウン塗り */
  .session-btn-main {
    background: var(--dark-brown);
    color: var(--ivory);
    border-color: var(--dark-brown);
  }

  .session-btn-main:hover {
    background: var(--gold);
    color: var(--dark-brown);
    border-color: var(--gold);
  }

  /* フォローアップボタン：アウトライン */
  .session-btn-followup {
    background: transparent;
    color: var(--warm-brown);
    border-color: rgba(139,109,90,0.45);
  }

  .session-btn-followup:hover {
    background: rgba(139,109,90,0.1);
    color: var(--dark-brown);
    border-color: var(--warm-brown);
  }

  .session-btn svg { flex-shrink: 0; }

  /* ── PRICE ── */
  .price {
    background: var(--cream);
    padding: var(--section-pad) 0;
    position: relative;
  }

  .price::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }

  .price-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    margin-top: 56px;
  }

  .price-card {
    background: var(--ivory);
    padding: 44px 40px;
    border-top: 3px solid var(--gold);
  }

  .price-card-label {
    font-size: clamp(10px, 0.75vw, 13px);
    letter-spacing: 4px;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .price-card-title {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(18px, 1.6vw, 26px);
    color: var(--dark-brown);
    margin-bottom: 20px;
  }

  .price-amount {
    font-family: 'Zen Old Mincho', serif;
    font-size: clamp(38px, 3.8vw, 62px);
    color: var(--dark-brown);
    line-height: 1;
  }

  .price-amount sub {
    font-size: clamp(13px, 1vw, 17px);
    font-family: 'Noto Sans JP', sans-serif;
    color: var(--text-light);
  }

  .price-amount small {
    font-size: clamp(13px, 1vw, 16px);
    font-family: 'Noto Sans JP', sans-serif;
    color: var(--text-light);
    display: block;
    margin-top: 6px;
  }

  .price-divider {
    height: 1px;
    background: rgba(139,109,90,0.2);
    margin: 24px 0;
  }

  .price-detail {
    font-size: clamp(14px, 1.1vw, 17px);
    line-height: 2.1;
    color: var(--text-light);
  }

  /* ── FORM ── */
  .form-section {
    background: var(--dark-brown);
    padding: var(--section-pad) 0;
    position: relative;
    overflow: hidden;
  }

  .form-section::after {
    content: '';
    position: absolute;
    bottom: -100px; right: -100px;
    width: 400px; height: 400px;
    border-radius: 50%;
    border: 1px solid rgba(196,162,101,0.1);
  }

  .form-section .section-title { color: var(--ivory); }
  .form-section .section-label { color: var(--gold); }

  .form-wrapper {
    max-width: 660px;
    margin: 52px auto 0;
  }

  .form-row { margin-bottom: 24px; }

  .form-label {
    display: block;
    font-size: clamp(11px, 0.85vw, 14px);
    letter-spacing: 2px;
    color: rgba(250,246,240,0.6);
    margin-bottom: 9px;
  }

  .form-label .required {
    color: var(--blush);
    margin-left: 6px;
  }

  .form-input, .form-select, .form-textarea, .form-checkbox-group {
    width: 100%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(196,162,101,0.25);
    color: var(--ivory);
    padding: clamp(12px,1vw,16px) clamp(14px,1.2vw,20px);
    font-family: 'Noto Sans JP', sans-serif;
    font-size: clamp(14px, 1.1vw, 17px);
    outline: none;
    transition: border-color 0.3s;
    border-radius: 0;
    -webkit-appearance: none;
    appearance: none;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--gold);
  }

  .form-input::placeholder, .form-textarea::placeholder {
    color: rgba(250,246,240,0.25);
  }

  .form-select option {
    background: var(--dark-brown);
    color: var(--ivory);
  }

  .form-textarea { height: 130px; resize: vertical; }

  .checkbox-list { display: flex; flex-direction: column; gap: 0; }

  .checkbox-item {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    padding: 10px 4px;
    border-bottom: 1px solid rgba(196,162,101,0.1);
    transition: background 0.2s;
  }

  .checkbox-item:hover { background: rgba(196,162,101,0.06); }

  .checkbox-item input[type="checkbox"] {
    width: 17px; height: 17px;
    accent-color: var(--gold);
    cursor: pointer;
    flex-shrink: 0;
  }

  .checkbox-item label {
    font-size: clamp(13px, 1vw, 16px);
    color: rgba(250,246,240,0.8);
    cursor: pointer;
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .checkbox-date {
    font-size: clamp(11px, 0.85vw, 14px);
    color: rgba(196,162,101,0.7);
    margin-left: 12px;
    white-space: nowrap;
  }

  .form-submit {
    width: 100%;
    background: var(--gold);
    color: var(--dark-brown);
    border: none;
    padding: clamp(16px,1.4vw,22px);
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(14px, 1.1vw, 18px);
    font-weight: 600;
    letter-spacing: 3px;
    cursor: pointer;
    transition: all 0.3s;
    margin-top: 20px;
  }

  .form-submit:hover {
    background: var(--light-gold);
    transform: translateY(-2px);
  }

  .form-field-salon-check {
    margin-top: 10px;
  }

  .form-checkbox-inline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: clamp(13px, 1vw, 15px);
    color: rgba(250,246,240,0.75);
  }

  .form-checkbox-inline input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--gold);
    cursor: pointer;
    flex-shrink: 0;
  }

  .form-caution {
    margin-top: 20px;
    padding: 14px 18px;
    border: 1px solid rgba(212,164,154,0.5);
    border-left: 3px solid var(--blush);
    font-size: clamp(12px, 0.9vw, 14px);
    color: rgba(212,164,154,0.9);
    line-height: 2;
  }

  .form-field-note {
    font-size: clamp(11px, 0.8vw, 13px);
    color: rgba(196,162,101,0.7);
    margin-top: 6px;
    padding-left: 2px;
  }

  .form-note {
    font-size: clamp(11px, 0.85vw, 14px);
    color: rgba(250,246,240,0.35);
    text-align: center;
    margin-top: 14px;
    line-height: 2;
  }

  /* ── ENTRY (Square booking) ── */
  .entry-wrapper {
    max-width: 680px;
    margin: 52px auto 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .payment-notice {
    background: rgba(196,162,101,0.1);
    border: 1px solid rgba(196,162,101,0.35);
    border-left: 3px solid var(--gold);
    padding: 24px 28px;
  }

  .payment-notice-title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(13px, 1vw, 16px);
    color: var(--gold);
    letter-spacing: 1px;
    margin-bottom: 14px;
  }

  .payment-notice-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .payment-notice-list li {
    font-size: clamp(13px, 1vw, 15px);
    color: rgba(250,246,240,0.8);
    line-height: 1.8;
    padding-left: 1.2em;
    position: relative;
